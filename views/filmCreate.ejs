<%- include("partials/header") %>
  <title>Film létrehozása</title>
</head>
<body>
  <h1>Film létrehozása</h1>

  <% if (errors.length > 0) { %>
  <div role="alert">
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }); %>
    </ul>
  </div>
<% } %>



  <form action="/filmCRUD/create" method="POST">
     <p>
      <label for="_id">Film sorszám:</label><br>
      <input
        type="number"
        id="_id"
        name="_id"
        value="<%= film._id %>"
        required
      >
    </p>


    <p>
      <label for="cim">Film címe:</label><br>
      <input
        type="text"
        id="cim"
        name="cím"
        value="<%= film.cím %>"
        required
      >
    </p>

    <p>
      <label for="gyartas">Gyártási év:</label><br>
      <input
        type="number"
        id="gyartas"
        name="gyartas"
        value="<%= film.gyartas %>"
        step="1"
        required
      >
    </p>

    <p>
      <label for="hossz">Hossz (perc):</label><br>
      <input
        type="number"
        id="hossz"
        name="hossz"
        value="<%= film.hossz ?? '' %>"
        min="0"
      >
    </p>

    <p>
      <label for="bemutato">Bemutató:</label><br>
      <input
        type="date"
        id="bemutato"
        name="bemutato"
        value="<%= film.bemutato ?? '' %>"
      >
    </p>

    <p>
      <label for="youtube">
        <input
          type="checkbox"
          id="youtube"
          name="youtube"
          <%= film.youtube ? 'checked' : '' %>
        >
        Elérhető YouTube-on
      </label>
    </p>

    <button type="submit">Mentés</button>
    <a href="/CRUD">Mégse</a>
  </form>
<%- include("partials/footer") %>
</body>
</html>