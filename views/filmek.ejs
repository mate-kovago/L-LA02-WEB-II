<%- include("partials/header") %>
  <title>Hangosfilmek</title>
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid #ccc;
      padding: 10px;
      text-align: left;
    }

    th {
      background: #eee;
    }
  </style>
</head>
<body>
  <h1>Hangosfilmek</h1>

  <table>
    <thead>
      <tr>
        <th>Film címe</th>
        <th>Gyártási év</th>
        <th>Első rendező</th>
      </tr>
    </thead>

    <tbody>
      <% if (filmek.length === 0) { %>
        <tr>
          <td colspan="3">Nincs megjeleníthető film.</td>
        </tr>
      <% } %>

      <% filmek.forEach((film) => { %>
        <tr>
          <td><%= film.cím %></td>
          <td><%= film.gyartas %></td>
          <td><%= film.rendezo %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <%- include("partials/footer") %>
</body>
</html>