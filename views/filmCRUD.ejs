<%- include("partials/header") %>
  <title>filmCRUD</title>
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid #ccc;
      padding: 10px;
      text-align: left;
    }

    th {
      background: #eee;
    }
  </style>
</head>
<body>
  <h1>Hangosfilmek</h1>

  <p>
  <a href="/filmCRUD/create">Film létrehozása</a>
</p>

  <table>
    <thead>
      <tr>
        <th>Film címe</th>
        <th>Gyártási év</th>
        <th>Hossz</th>
        <th>Bemutató</th>
        <th>Youtube</th>
        <th>Műveletek</th>
      </tr>
    </thead>

    <tbody>
      <% if (filmek.length === 0) { %>
        <tr>
          <td colspan="6">Nincs megjeleníthető film.</td>
        </tr>
      <% } %>

      <% filmek.forEach((film) => { %>
        <tr>
          <td><%= film.cím %></td>
          <td><%= film.gyartas %></td>
          <td><%= film.hossz %></td>
          <td><%= film.bemutato %></td>
          <td><%= film.youtube ? 'igen' : 'nem' %></td>
          <td><a href="/filmCRUD/edit/<%= film._id %>">
              Szerkesztés
            </a>
       <form
          action="/filmCRUD/delete/<%= film._id %>"
          method="POST"
          style="display: inline;"
>
          <button type="submit" class="torles">Törlés</button>
        </form></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<%- include("partials/footer") %>
</body>
</html>