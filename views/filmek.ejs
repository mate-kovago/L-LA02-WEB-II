<tbody>
    <% if (filmek.length === 0) { %>
        <tr>
            <td colspan="3">Nincs megjeleníthető film.</td>
        </tr>
    <% } %>

    <% filmek.forEach((film) => { %>
        <tr>
            <td><%= film.cím %></td>
            <td><%= film.gyartas %></td>
            <td>
                <%= film.feladatok[0]?.szemely?.nev ?? 'Nincs adat' %>
            </td>
        </tr>
    <% }); %>
</tbody>